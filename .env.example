# --- Proveedor de chat ---------------------------------------------------
# El SDK por defecto usa "echo" (sin API key) para que la variante SDK sea
# verificable sin credenciales. Con "openai" usa el mismo backend que el
# server manual (a2a_agent/llm.py).
CHAT_PROVIDER="echo"

# --- OpenAI (solo si CHAT_PROVIDER=openai) -------------------------------
OPENAI_API_KEY="sk-"
OPENAI_MODEL="gpt-4o-mini"

# --- Identidad del agente -------------------------------------------------
AGENT_NAME="SDK Agent"
AGENT_DESCRIPTION="A conversational agent exposed over the A2A protocol via the official SDK."

# --- Servidor ------------------------------------------------------------
HOST="127.0.0.1"
PORT="2026"
# URL base publica que aparece en el Agent Card (default: http://HOST:PORT)
#PUBLIC_URL="http://127.0.0.1:2026"

# --- Auth por path (gateway multi-agente) --------------------------------
# Si se define, el JSON-RPC de /a2a/portfolio-qa exige header X-API-Key.
# En produccion la key va en el secret manager, no en .env.
#PORTFOLIO_QA_API_KEY="dev-key"

# --- Agent Orchestrator (src-agent-orchestrator/server.py) ---------------
# Proveedor LLM: "echo" (sin API key, determinista) | "google" | "openai".
ORCHESTRATOR_PROVIDER="echo"
ORCHESTRATOR_MODEL="gemini-2.5-flash"
#ORCHESTRATOR_HOST="127.0.0.1"
#ORCHESTRATOR_PORT="8020"
# A2A: "true" simula el dispatch del agente remoto (dev local); "false" hace
# HTTP real hacia el endpoint de la Agent Card y degrada si no responde.
#ORCHESTRATOR_MOCK_A2A="true"
#ORCHESTRATOR_A2A_TIMEOUT="5.0"